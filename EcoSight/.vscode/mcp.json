{
  "servers": {
    "ecosight-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ORS_API_KEY": "${input:orsApiKey}",
        "OWM_API_KEY": "${input:owmApiKey}",
        "NEWS_API_KEY": "${input:newsApiKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "orsApiKey",
      "type": "promptString",
      "description": "OpenRouteService API key",
      "password": true
    },
    {
      "id": "owmApiKey",
      "type": "promptString",
      "description": "OpenWeatherMap API key",
      "password": true
    },
    {
      "id": "newsApiKey",
      "type": "promptString",
      "description": "NewsAPI key",
      "password": true
    }
  ]
}
